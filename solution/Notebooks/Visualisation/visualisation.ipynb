    "    \"              color='language',\\n\",\n",
    "    \"              title=\\\"Top 15 Language Usage in Films Over Time\\\",\\n\",\n",
    "    \"              labels={'film_count': 'Number of Films', 'year': 'Year', 'language': 'Language'},\\n\",\n",
    "    \"              markers=True)\\n\",\n",
    "    \"fig.show()\"\n",
    "   ],\n",
