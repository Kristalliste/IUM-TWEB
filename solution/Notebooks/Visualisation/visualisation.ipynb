    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import plotly.graph_objects as go\\n\",\n",
    "    \"import plotly.express as px\\n\",\n",
    "    \"import nbformat\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import functions as fun\\n\",\n",
    "    \"import squarify\"\n",
    "   ],\n",
    "   \"id\": \"4adb132a93d0258f\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-05-10T08:11:08.700841Z\",\n",
    "     \"start_time\": \"2025-05-10T08:10:49.187737Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"actors_df = pd.read_csv('../../Data/DataFinal/actors_v2.csv')\\n\",\n",
    "    \"countries_df = pd.read_csv('../../Data/DataFinal/countries_v2.csv')\\n\",\n",
    "    \"crew_df = pd.read_csv('../../Data/DataFinal/crew_v2.csv')\\n\",\n",
    "    \"genres_df = pd.read_csv('../../Data/DataFinal/genres_v2.csv')\\n\",\n",
    "    \"languages_df = pd.read_csv('../../Data/DataFinal/languages_v2.csv')\\n\",\n",
    "    \"movies_df = pd.read_csv('../../Data/DataFinal/movies_v2.csv', parse_dates=['date'], low_memory=False)\\n\",\n",
    "    \"posters_df = pd.read_csv('../../Data/DataFinal/posters_v2.csv')\\n\",\n",
    "    \"releases_df = pd.read_csv('../../Data/DataFinal/releases_v2.csv', parse_dates=['date'])\\n\",\n",
    "    \"reviews_df = pd.read_csv('../../Data/DataFinal/rotten_tomatoes_reviews_v2.csv', parse_dates=['review_date'])\\n\",\n",
    "    \"studios_df = pd.read_csv('../../Data/DataFinal/studios_v2.csv')\\n\",\n",
    "    \"oscar_df = pd.read_csv('../../Data/DataFinal/the_oscar_awards_v2.csv')\\n\",\n",
    "    \"themes_df = pd.read_csv('../../Data/DataFinal/themes_v2.csv')\"\n",
    "   ],\n",
    "   \"id\": \"4db13d7bb999b31c\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"plt.style.use('ggplot')\",\n",
    "   \"id\": \"53349df57fe66402\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"In this phase we will analyse in details the singular features of each dataset, using graphs in order to get a better grasp of their contents, before formulating hypothesis and diving deeper into the correlations between them.\",\n",
    "   \"id\": \"c799d9d45f4b7acf\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Actors Examination\",\n",
    "   \"id\": \"be032be7359755ff\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"actor_count = actors_df.groupby('name')['id'].nunique().reset_index()\\n\",\n",
    "    \"# Sorting the actors by the number of films they have appeared in\\n\",\n",
    "    \"actor_count = actor_count.sort_values(by='id', ascending=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Bar plot\\n\",\n",
    "    \"plt.figure(figsize=(12, 6))\\n\",\n",
    "    \"sns.barplot(x='id', y='name', data=actor_count.head(15), hue='name', palette='viridis')\\n\",\n",
    "    \"plt.xlabel('Number of Films')\\n\",\n",
    "    \"plt.ylabel('Actor')\\n\",\n",
    "    \"plt.title('Top 15 Most Proficient Actors by Number of Films')\\n\",\n",
    "    \"#fig.update_layout(margin={\\\"r\\\":10,\\\"t\\\":40,\\\"l\\\":10,\\\"b\\\":40})\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"d4c5d10243a6665d\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"We can easily see how **Mel Blanc** is the most prolific actor in the dataset. He was an American voice actor, who voiced numerous characters form extremely famous films and cartoons. This implies that it is much more common for voice actors to take part to many films, compared to actors, whose work dedicated to each film probably takes longer on average.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Bess Flowers** was specialised in working as an extra, which explains how she could partecipate in over 700 films during her career.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Jagathy Sreekumar, Mammotty and Mohanlal** were Indian actors, and their extensive careers are due to the high prolificacy of the Indian cinema industry.\"\n",
    "   ],\n",
    "   \"id\": \"3cbd37a00342b34d\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"actor_role_counts = actors_df.groupby('name')['role'].nunique()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Select the top 20 actors who have played the most different roles\\n\",\n",
    "    \"top_actors_roles = actor_role_counts.nlargest(15).reset_index()\\n\",\n",
    "    \"top_actors_roles.columns = ['Actor', 'Unique Roles']\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create Treemap with Plotly Express\\n\",\n",
    "    \"fig = px.treemap(top_actors_roles,\\n\",\n",
    "    \"                 path=['Actor'],\\n\",\n",
    "    \"                 values='Unique Roles',\\n\",\n",
    "    \"                 color='Unique Roles',\\n\",\n",
    "    \"                 color_continuous_scale='magma',\\n\",\n",
    "    \"                 title='Top 15 Actors Who Played the Most Different Roles')\\n\",\n",
    "    \"fig.update_traces(hovertemplate=\\\"<b>%{label}</b><br>Unique Roles: %{value}\\\")\\n\",\n",
    "    \"fig.update_layout(margin={\\\"r\\\":10,\\\"t\\\":40,\\\"l\\\":10,\\\"b\\\":40})\\n\",\n",
    "    \"fig.show()\"\n",
    "   ],\n",
    "   \"id\": \"fc01e269ead74e55\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"COMMENTINI, correlazione tra più film e piu ruoli\",\n",
    "   \"id\": \"775e10ab02d73095\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Country Trends\\n\",\n",
    "   \"id\": \"407c63beafd3f30d\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"Top 15 Countries who hosted more films\",\n",
    "   \"id\": \"ac3644218189afab\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"    - df -> column 'id', 'country'\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"# Count number of film per country\\n\",\n",
    "    \"countries_count = countries_df['country'].value_counts().head(15)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create the bar chart\\n\",\n",
    "    \"plt.figure(figsize=(10, 6))\\n\",\n",
    "    \"countries_count.plot(kind='bar', color=fun.color_palette(countries_count), edgecolor='black')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add labels and title\\n\",\n",
    "    \"plt.title('Numero di Film Registrati per Paese', fontsize=16)\\n\",\n",
    "    \"plt.xlabel('Paese', fontsize=14)\\n\",\n",
    "    \"plt.ylabel('Numero di Film', fontsize=14)\\n\",\n",
    "    \"plt.xticks(rotation=45)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Show the plot\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"e10cdf5ab459182d\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Crew Trends\",\n",
    "   \"id\": \"8f3c373e59ed37d2\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"### Let's see the top 15 people who had a role as Director for more films.\",\n",
    "   \"id\": \"7d2684b59cac4757\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"    Creates a vertical lollipop chart showing the top 15 Directors\\n\",\n",
    "    \"    based on the number of films they directed.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"    - crew_df: DataFrame with columns 'id', 'role', 'name'\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Filtro per il ruolo di 'Director'\\n\",\n",
    "    \"directors_df = crew_df[crew_df['role'].str.lower() == 'director']\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Conta il numero di film per ogni director (Top 15)\\n\",\n",
    "    \"director_counts = directors_df['name'].value_counts().head(15)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Definire i colori\\n\",\n",
    "    \"colors = sns.color_palette('viridis', len(director_counts))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Creazione del grafico\\n\",\n",
    "    \"plt.figure(figsize=(14, 8))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Linee verticali\\n\",\n",
    "    \"plt.vlines(\\n\",\n",
    "    \"    x=director_counts.index,\\n\",\n",
    "    \"    ymin=0,\\n\",\n",
    "    \"    ymax=director_counts.values,\\n\",\n",
    "    \"    color=colors,\\n\",\n",
    "    \"    linewidth=2,\\n\",\n",
    "    \"    alpha=0.7\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Marker\\n\",\n",
    "    \"plt.scatter(\\n\",\n",
    "    \"    x=director_counts.index,\\n\",\n",
    "    \"    y=director_counts.values,\\n\",\n",
    "    \"    color=colors,\\n\",\n",
    "    \"    s=100,\\n\",\n",
    "    \"    zorder=3\\n\",\n",
    "    \")\\n\",\n",
    "    \" # Spacing between dots and values\\n\",\n",
    "    \"spacing = 10  # Adjust this value to increase/decrease spacing\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Aggiunta di etichette sopra i marker\\n\",\n",
    "    \"for i, value in enumerate(director_counts.values):\\n\",\n",
    "    \"    plt.text(\\n\",\n",
    "    \"        i,\\n\",\n",
    "    \"        value + spacing,\\n\",\n",
    "    \"        f'{value}',\\n\",\n",
    "    \"        ha='center',\\n\",\n",
    "    \"        va='bottom',\\n\",\n",
    "    \"        fontsize=10,\\n\",\n",
    "    \"        fontweight='bold'\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Titoli e etichette\\n\",\n",
    "    \"plt.title('Top 15 Directors by Number of Films', fontsize=16, weight='bold', pad=20)\\n\",\n",
    "    \"plt.xlabel('Director', fontsize=14)\\n\",\n",
    "    \"plt.ylabel('Number of Films', fontsize=14)\\n\",\n",
    "    \"plt.xticks(rotation=45, ha='right', fontsize=12)\\n\",\n",
    "    \"plt.grid(axis='y', linestyle='--', alpha=0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"c2ff44853e56c115\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"COMMENTI FINALI\",\n",
    "   \"id\": \"747ece475c83a37e\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Genre Trends\",\n",
    "   \"id\": \"b766eda2e78d2b11\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"The 15 most common genre.\",\n",
    "   \"id\": \"da9d0e29231efaa7\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"    Crea un doughnut chart che mostra i 15 generi più comuni nel dataset.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parametri:\\n\",\n",
    "    \"    - genres_df: DataFrame con colonne 'id' e 'genre'\\n\",\n",
    "    \"    - palette: Nome della colormap (es. 'viridis', 'plasma', 'cool', 'hot')\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calcola la frequenza di ciascun genere\\n\",\n",
    "    \"genre_counts = genres_df['genre'].value_counts().head(15)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Definisce la palette\\n\",\n",
    "    \"colors = sns.color_palette('viridis', len(genre_counts))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Crea il doughnut chart\\n\",\n",
    "    \"plt.figure(figsize=(7, 10))\\n\",\n",
    "    \"wedges, texts, autotexts = plt.pie(\\n\",\n",
    "    \"    genre_counts.values,\\n\",\n",
    "    \"    labels=genre_counts.index,\\n\",\n",
    "    \"    colors=colors,\\n\",\n",
    "    \"    autopct='%1.1f%%',\\n\",\n",
    "    \"    startangle=140,\\n\",\n",
    "    \"    pctdistance=0.85,  # Distanza delle percentuali dal centro\\n\",\n",
    "    \"     textprops={'fontsize': 10, 'weight': 'bold'}  # Ensure numbers are in black\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Creazione del cerchio interno per il doughnut\\n\",\n",
    "    \"centre_circle = plt.Circle((0, 0), 0.70, color='white')\\n\",\n",
    "    \"plt.gca().add_artist(centre_circle)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Titolo e layout\\n\",\n",
    "    \"plt.title('Top 15 Generi più Comuni - Doughnut Chart', fontsize=16, weight='bold', pad=20)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\"\n",
    "   ],\n",
    "   \"id\": \"82f678f21de36840\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"COMMENTI FINALI\",\n",
    "   \"id\": \"27da9a051e7f5550\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Language Trends\",\n",
    "   \"id\": \"cb233c4d31aed070\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"lang_movie_df = fun.language_movies_merge(languages_df, movies_df)\\n\",\n",
    "    \"lang_usage = fun.top15_language_trend(lang_movie_df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig = px.line(lang_usage,\\n\",\n",
