    "    \"\\n\",\n",
    "    \"sns.boxplot(y=movies_df['minute'], ax=axes[1], color='skyblue')\\n\",\n",
    "    \"axes[1].set_title('Box Plot of Film Lengths')\\n\",\n",
    "    \"axes[1].set_ylabel('Minutes')\\n\",\n",
    "    \"axes[1].set_ylim(0, 300)\\n\",\n",
    "    \"\\n\",\n",
