    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(10, 4))\\n\",\n",
    "    \"\\n\",\n",
    "    \"sns.histplot(movies_df['minute'], bins=10000, kde=False, ax=axes[0], color='skyblue')\\n\",\n",
