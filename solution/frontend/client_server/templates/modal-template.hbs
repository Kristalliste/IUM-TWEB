<div class="modal-content">
    <span class="close">&times;</span>
    <div class="modal-header">
        <img id="detailPoster" src="{{posterUrl}}" alt="Movie Poster" class="modal-poster" />
        <div class="movie-details">
            <h2 id="detailTitle">{{title}}</h2>
            <div class="detail-rating">
                <span id="detailYear">{{year}}</span>
                <i class="fas fa-clock"></i>
                <span id="detailMinute">{{minute}} min</span>
                <i class="fas fa-star icon-star"></i>
                <span id="detailRating">{{rating}}</span>
                {{#if hasOscar}}
                    <span id="detailOscarIcon" class="bi bi-award" title="Nominated to the Oscar Awards"></span>
                {{/if}}
            </div>
            <p id="detailDescription">{{description}}</p>
            <div style="margin-top: 1cm; text-align: center;">
                <a id="detailLink" href="#" class="details-link">
                    <i class="fas fa-info-circle"></i> View Full Details and Reviews
                </a>
            </div>
        </div>
    </div>
</div>