<!-- advanced-search.hbs -->
<div class="container">
    <h2 id="search-page-title">Advanced Search</h2>
    <div class="search-controls-container">
        <div class="search-form">
            <div class="form-group">
                <label for="search-type">Search Type:</label>
                <select id="search-type">
                    <option value="TITLE">Title</option>
                    <option value="YEAR">Year</option>
                    <option value="GENRE">Genre</option>
                    <option value="LANGUAGE">Language</option>
                    <option value="ACTOR">Actor</option>
                </select>
            </div>

            <div class="form-group">
                <label>Search:</label>
                <input type="text" id="search-input" placeholder="Enter search value...">
                <select id="search-genre" style="display: none;">
                    <option value="">Select a genre</option>
                </select>
            </div>

            <div class="form-group">
                <label for="page-size">Results per page:</label>
                <select id="page-size">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>

            <button class="search-button" id="search-button">Search</button>
        </div>
    </div>

    <div id="movie-grid-search" class="movie-grid">
        <!-- Results will appear here -->
    </div>

    <div id="pagination-container-search" class="pagination-container">
        <!-- Pagination will appear here -->
    </div>

    <div id="movie-detail-view-search" class="container">
        <!-- Film details will be inserted here -->
    </div>
</div>

